{
  "enabled": true,
  "name": "Keep README in sync",
  "description": "When the CLI or MCP tools change, update README usage docs.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/cli.js", "mcp-server/server.js"] },
  "then": { "type": "askAgent", "prompt": "Update the Usage and MCP Tools sections of README.md to match the code change." }
}
