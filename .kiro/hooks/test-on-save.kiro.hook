{
  "enabled": true,
  "name": "Run tests on source save",
  "description": "Runs the full test suite (incl. property tests) whenever core source or tests change.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.js", "test/**/*.js"] },
  "then": { "type": "askAgent", "prompt": "Run `npm test`. If any test fails, explain the failure and propose a fix that respects .kiro/steering/tech.md (integer cents only)." }
}
